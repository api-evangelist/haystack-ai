  "info": {
    "_postman_id": "e725d609-1052-456d-b789-095fd9002f96",
    "name": "deepset Cloud API (deepset AI Platform) Files API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Hosted REST API for the deepset AI Platform (deepset Cloud), the commercial product built on the open-source Haystack framework. The API lets you manage workspaces, create and deploy Haystack pipelines, upload and index files, and run searches against deployed pipelines. All resource endpoints are prefixed with /api/v1 and authenticated with a Bearer API key generated in the platform UI. The open-source Haystack framework itself is a Python library, not a hosted REST API; this specification models only the documented deepset Cloud REST endpoints.\n\nContact Support:\n Name: deepset Support",
      "type": "text/plain"
    }
  }
}